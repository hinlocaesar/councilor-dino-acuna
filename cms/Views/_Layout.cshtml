@using Umbraco.Cms.Web.Common.PublishedModels
@model IPublishedContent
@{
    Layout = null;
    var pageTitle = Model.Value<string>("title");
    var isHome = Model.ContentType.Alias == "home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? Model.Name : pageTitle) — Victorias City, Negros Occidental</title>
    <meta name="description" content="Official page of Councilor Dino Acuña of the City of Victorias, Negros Occidental. Public service since 1992." />
    <meta name="theme-color" content="#05100e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@Model.Name" />
    <meta property="og:description" content="Pariente sang Masa. Public service since 1992." />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://dinoacuna.wordpress.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%230b1f1a'/%3E%3Ctext x='50' y='63' font-family='Georgia,serif' font-size='46' font-weight='700' fill='%23e0b463' text-anchor='middle'%3EDA%3C/text%3E%3C/svg%3E" />
</head>
<body class="@(isHome ? "is-home" : "")">

<a class="skip-link" href="#main">Skip to content</a>
<div class="scroll-progress" aria-hidden="true"><span data-progress-bar></span></div>

@* ============================== header ============================== *@
<header class="site-header" data-header>
    <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Councilor Dino Acuña — home">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 44 44" fill="none"><path d="M22 3 39 12.5v19L22 41 5 31.5v-19L22 3Z" stroke="currentColor" stroke-width="1.4" opacity=".45"/><text x="22" y="28" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-size="16" font-weight="700" fill="currentColor">DA</text></svg>
            </span>
            <span class="brand-text">
                <strong>Dino Acuña</strong>
                <small>City Councilor · Victorias City</small>
            </span>
        </a>

        <nav class="nav" id="nav" aria-label="Primary">
            <a href="/#about">About</a>
            <a href="/#record">Record</a>
            <a href="/#programs">Programs</a>
            <a href="/#heritage">Heritage</a>
            <a href="/#videos">Videos</a>
            <a href="/#journal">Journal</a>
            <a class="nav-cta" href="/#connect">Get in touch</a>
        </nav>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav" aria-label="Open menu" data-nav-toggle>
            <span></span><span></span><span></span>
        </button>
    </div>
</header>
<div class="nav-scrim" data-nav-scrim hidden></div>

<main id="main">
    @RenderBody()
</main>

@* ============================== footer ============================== *@
<footer class="site-footer">
    <div class="shell footer-inner">
        <div class="footer-brand">
            <strong>Hon. Dino Jose Maria G. Acuña</strong>
            <p>Councilor · City of Victorias, Negros Occidental, Philippines<br />Pariente sang Masa</p>
        </div>
        <nav class="footer-nav" aria-label="Footer">
            <a href="/#about">About</a>
            <a href="/#record">Record</a>
            <a href="/#programs">Programs</a>
            <a href="/#videos">Videos</a>
            <a href="/#journal">Journal</a>
            <a href="/#connect">Connect</a>
        </nav>
        <p class="footer-note">
            Content managed in Umbraco. Photographs and writing remain the work of their
            original author, Dino Acuña. <em>Padayon, Victorias City!</em>
        </p>
    </div>
</footer>

@* ============================== video modal ============================== *@
<div class="modal" data-modal hidden>
    <div class="modal-backdrop" data-modal-close></div>
    <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <button class="modal-close" type="button" aria-label="Close video" data-modal-close>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
        <div class="modal-frame" data-modal-frame></div>
        <div class="modal-meta">
            <h3 id="modal-title" data-modal-title></h3>
            <p data-modal-sub></p>
            <a class="link link-strong" data-modal-link href="#" target="_blank" rel="noopener">
                Open on Facebook
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8M18 13v5.5A1.5 1.5 0 0 1 16.5 20h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H11" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
        </div>
    </div>
</div>

<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>

