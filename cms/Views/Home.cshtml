@using Umbraco.Cms.Core.Models.PublishedContent
@{
    Layout = "_Layout.cshtml";

    // Bind the model explicitly — the default is dynamic, which breaks LINQ.
    var root = (IPublishedContent)Model;

    // ---- content pulled from the backoffice
    var videos = root.Children
        .OfType<IPublishedContent>()
        .Where(c => c.ContentType.Alias == "video")
        .OrderBy(c => c.Value<string>("sortKey"))
        .ToList();

    var posts = root.Children
        .OfType<IPublishedContent>()
        .Where(c => c.ContentType.Alias == "blogPost")
        .OrderBy(c => c.Value<string>("sortKey"))
        .ToList();

    var milestones = root.Children
        .OfType<IPublishedContent>()
        .Where(c => c.ContentType.Alias == "milestone")
        .OrderBy(c => c.Value<string>("sortKey"))
        .ToList();

    string CatLabel(string? c) => c switch
    {
        "program" => "Programme",
        "field" => "Field",
        _ => "Council"
    };
    var arrow = "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>";
}

@* ============================== HERO ============================== *@
<section class="hero" id="home">
    <div class="hero-bg" aria-hidden="true">
        <span class="orb orb-a"></span>
        <span class="orb orb-b"></span>
        <span class="orb orb-c"></span>
        <div class="hero-grid"></div>
    </div>

    <div class="shell hero-inner">
        <p class="eyebrow reveal">
            <span class="eyebrow-dot"></span>
            Sangguniang Panlungsod · City of Victorias, Negros Occidental
        </p>

        <h1 class="hero-title reveal" data-delay="1">
            <span class="line">Councilor</span>
            <span class="line name">Dino&nbsp;Acuña</span>
        </h1>

        <p class="hero-lede reveal" data-delay="2">
            A true-blooded Negrense of Victorias City. Youth councilman at sixteen,
            ex-officio member of the Provincial Board, City Administrator, and now a
            member of the City Council — carrying <em>pariente sang masa</em> into every
            ordinance, program, and conversation.
        </p>

        <div class="hero-actions reveal" data-delay="3">
            <a class="btn btn-primary" href="#record">View the record @Html.Raw(arrow)</a>
            <a class="btn btn-ghost" href="#videos">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor"/></svg>
                Watch the videos
            </a>
        </div>

        <dl class="hero-stats reveal" data-delay="4">
            <div><dt>1992</dt><dd>Entered public life</dd></div>
            <div><dt>30+</dt><dd>Years in service</dd></div>
            <div><dt>26</dt><dd>Barangays served</dd></div>
            <div><dt>7.8K</dt><dd>Community following</dd></div>
        </dl>
    </div>

    <a class="scroll-hint" href="#about" aria-label="Scroll to About">
        <span class="scroll-hint-line" aria-hidden="true"></span>
        Scroll
    </a>
</section>

@* ============================== TICKER ============================== *@
<div class="ticker" aria-hidden="true">
    <div class="ticker-track">
        @for (var i = 0; i < 2; i++)
        {
            <span>Adopt-a-Forest</span><span>·</span>
            <span>Pariente sang Masa</span><span>·</span>
            <span>Kadalag-an Festival</span><span>·</span>
            <span>Botika Sang Masa</span><span>·</span>
            <span>Sugarcane Capital of the Philippines</span><span>·</span>
            <span>Padayon, Victorias!</span><span>·</span>
        }
    </div>
</div>

@* ============================== ABOUT ============================== *@
<section class="section" id="about">
    <div class="shell">
        <header class="section-head reveal">
            <p class="section-kicker">01 — About</p>
            <h2 class="section-title">A life measured in <em>service</em>, not in campaigns.</h2>
        </header>

        <div class="about-grid">
            <div class="about-media reveal">
                <figure class="frame frame-tall">
                    <img loading="lazy" decoding="async"
                         src="/img/editorial/imag0012.jpg"
                         alt="The 1935 Victorias City Hall, the seat of city government since cityhood." />
                    <figcaption>The 1935 City Hall of Victorias</figcaption>
                </figure>
                <figure class="frame">
                    <img loading="lazy" decoding="async"
                         src="/img/editorial/26062010532.jpg"
                         alt="Governor Lito Coscolluela swearing in the author as Provincial Sangguniang Kabataan Federation President in 1996." />
                    <figcaption>Sworn in as Provincial SK Federation President, 1996</figcaption>
                </figure>
            </div>

            <div class="about-body">
                <p class="lead reveal">
                    I come from a political clan of Victorias City — a descendant of
                    <strong>Alejandro Acuña Yap Quiña</strong>, a philanthropist of Chinese
                    ancestry who donated his landholdings to the then Municipality of
                    Victorias, the ground on which the city now stands.
                </p>

                <p class="reveal" data-delay="1">
                    My family came from a simple household. My parents were employees, and
                    what they bequeathed to us was not wealth but education. Father always
                    talked politics around the dinner table; Mother always made sure the
                    table was full. That childhood, I am convinced, is why public service
                    never felt like a career to me — it felt like an inheritance.
                </p>

                <p class="reveal" data-delay="2">
                    At sixteen, in 1992, I was elected Sangguniang Kabataan Chairman of my
                    village and eventually Federation President of the Municipality of
                    Victorias — becoming an ex-officio member of the Town Council while
                    serving as Provincial Federation Vice President. A second term later
                    took me to the Provincial Board, and to the National Executive Board of
                    the SK National Federation, where I helped draft the present SK
                    Constitution and By-Laws.
                </p>

                <blockquote class="pullquote reveal" data-delay="3">
                    <p>“Give a man a fish, and you feed him for a day; teach a man to fish, and you feed him for a lifetime.”</p>
                    <cite>— the principle behind the LGU–TESDA skills training partnership</cite>
                </blockquote>

                <p class="reveal" data-delay="4">
                    In between, I studied Community Development Economics at the
                    University of St. La Salle–Bacolod, later completed a Bachelor of
                    Science in Nursing, and returned to Negros as Chief of Staff to the
                    Mayor and then City Administrator of Victorias City. Today I sit once
                    more in the City Council — but the through-line never changed:
                    <em>pariente sang masa.</em>
                </p>

                <div class="about-facts reveal" data-delay="5">
                    <div><span>Full name</span><p>Hon. Dino Jose Maria G. Acuña — Councilor, 3rd Congressional District of Negros Occidental</p></div>
                    <div><span>Education</span><p>BA Community Development Economics, USL–Bacolod (1999) · BSN, University of West Negros–Bacolod (2007)</p></div>
                    <div><span>Boards &amp; clubs</span><p>Director, Victorias City Water District (since 2005) · Rotary Club of Victorias, Committee on Youth Development</p></div>
                    <div><span>Home ground</span><p>Victorias City, Negros Occidental — 34 km north of Bacolod, 26 barangays</p></div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ============================== RECORD ============================== *@
<section class="section section-alt" id="record">
    <div class="shell">
        <header class="section-head reveal">
            <p class="section-kicker">02 — The Record</p>
            <h2 class="section-title">Four decades in <em>public life</em>.</h2>
        </header>

        <ol class="timeline" data-timeline>
            @foreach (var m in milestones)
            {
                var isKey = m.Value<bool>("isKey");
                var mYear = m.Value<string>("milestoneYear");
                var mTitle = m.Value<string>("milestoneTitle");
                var mBody = m.Value<string>("milestoneBody");
                <li class="tl-item reveal @(isKey ? "is-key" : "")">
                    <span class="tl-year">@mYear</span>
                    <div class="tl-body">
                        <h3>@mTitle</h3>
                        <div>@Html.Raw(mBody)</div>
                    </div>
                </li>
            }
        </ol>
    </div>
</section>

@* ============================== PROGRAMS ============================== *@
<section class="section" id="programs">
    <div class="shell">
        <header class="section-head reveal">
            <p class="section-kicker">03 — Programs</p>
            <h2 class="section-title">Legislation that <em>touches ground</em>.</h2>
        </header>

        <div class="feature">
            <div class="feature-media reveal">
                <figure class="frame">
                    <img loading="lazy" decoding="async"
                         src="/img/editorial/20250322_082931.jpg"
                         alt="Participants planting endemic seedlings at Sitio VII, Gawahon Eco-Park, Victorias City." />
                    <figcaption>Sitio VII, Gawahon Eco-Park — International Day of Forests</figcaption>
                </figure>
            </div>
            <div class="feature-body reveal" data-delay="1">
                <p class="feature-tag">Ordinance No. 2024-159</p>
                <h3>Adopt-a-Forest Program</h3>
                <p>
                    The flagship ordinance of his council career makes forest stewardship a
                    shared civic duty. Government agencies, private organisations, schools,
                    barangays and ordinary citizens are invited to <strong>adopt one
                    hectare</strong> — either in the northwestern part of Mt. Silay in
                    Gawahon, within the Northern Negros Natural Park, or in open public
                    spaces designated by the Victorias City Environment and Natural
                    Resources Office.
                </p>

                <dl class="specs">
                    <div><dt>Upland</dt><dd>2,500 native tree seedlings</dd></div>
                    <div><dt>Coastal</dt><dd>5,000 malihaw seedlings</dd></div>
                    <div><dt>Care period</dt><dd>3 years of watering, grooming &amp; protection</dd></div>
                    <div><dt>Oversight</dt><dd>Tripartite agreement + monitoring committee</dd></div>
                </dl>

                <p class="feature-note">
                    The City Government supplies seedlings and handles transport and site
                    preparation; sponsors cover maintenance; residents of Gawahon are
                    employed to keep the trees alive. Barangay XI was the first to adopt an
                    area, setting the example for others.
                </p>
            </div>
        </div>

        <div class="cards">
            <article class="card reveal">
                <span class="card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M7 8h10l-1 11.5H8L7 8Zm5-2.5V4M9.5 11v5M14.5 11v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <h3>Botika Sang Masa</h3>
                <p>Bringing the city government's health programme down to the purok — medicines, vitamins and hygiene supplies distributed directly to barangay folk, in faithful compliance with the Anti-Epal Policy.</p>
            </article>

            <article class="card reveal" data-delay="1">
                <span class="card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 20s-7-4.35-7-9.5A4 4 0 0 1 12 8a4 4 0 0 1 7 2.5C19 15.65 12 20 12 20Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                </span>
                <h3>Adopt a Victoriasanon Family</h3>
                <p>Five consecutive years, since 2021, of showing up for one family each September — a fisherfolk household in 2026 — with the CSWD, because a simple act of kindness still brings hope.</p>
            </article>

            <article class="card reveal" data-delay="2">
                <span class="card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 5 6v5.5c0 4 2.9 7.7 7 9 4.1-1.3 7-5 7-9V6l-7-3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <h3>Skills &amp; livelihood</h3>
                <p>Backing the LGU–TESDA partnership so women and communities gain durable skills and sustainable livelihood — self-sufficiency instead of one-off assistance.</p>
            </article>

            <article class="card reveal" data-delay="3">
                <span class="card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M4 20V9m5 11V4m5 16v-7m5 7V6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </span>
                <h3>The sugar industry</h3>
                <p>Long advocacy for the sugar bill that would protect the livelihood of sugar-producing provinces — Negros Occidental chief among them — from a subsector too often left out of the room.</p>
            </article>
        </div>
    </div>
</section>

@* ============================== HERITAGE ============================== *@
<section class="section section-alt" id="heritage">
    <div class="shell">
        <header class="section-head reveal">
            <p class="section-kicker">04 — Heritage</p>
            <h2 class="section-title">The people and history he <em>carries</em>.</h2>
        </header>

        <div class="heritage-grid">
            <article class="heritage reveal">
                <img loading="lazy" decoding="async"
                     src="/img/editorial/fb_img_1742915516807-1.jpg"
                     alt="Sidlak sang Kadalag-an dancers performing at the Panaad sa Negros Festival." />
                <div class="heritage-body">
                    <p class="heritage-date">March 2025</p>
                    <h3>A grand slam for the Sidlak sang Kadalag-an</h3>
                    <p>Victorias' festival dancers took Best of Festival Dances at the Panaad sa Negros Festival — a third consecutive year under Mayor Javier Miguel L. Benitez, choreographed by Ricky Lapidante. The triumph also revived the image of St. Casimiro alongside the Jesuits, part of the Tukgagwan foranía heritage of 1728.</p>
                    <a class="link" href="https://dinoacuna.wordpress.com/2025/03/25/victorias-citys-sidlak-sang-kadalag-an-dancers-win-grandslam-champion-in-the-best-festival-of-dances-competion-of-the-2025-panaad-sa-negros/" target="_blank" rel="noopener">Read the account</a>
                </div>
            </article>

            <article class="heritage reveal" data-delay="1">
                <img loading="lazy" decoding="async"
                     src="/img/editorial/screenshot_20250321_060000_chrome-1.jpg"
                     alt="Mayor Severo Acuña Palanca, the visionary behind the cityhood of Victorias." />
                <div class="heritage-body">
                    <p class="heritage-date">Charter Day</p>
                    <h3>Severo A. Palanca, father of the cityhood</h3>
                    <p>The town leader whose tireless lobbying turned Victorias into a component city. Congressman Kako Lacson, Senators Pimentel, Sotto, Maceda, and President Fidel V. Ramos were among the allies — and a 7-year-old boy carrying an SK resolution to the Senate.</p>
                    <a class="link" href="https://dinoacuna.wordpress.com/2025/03/22/honoring-mayor-severo-a-palanca-the-visionary-behind-victorias-cityhood-mayor-javier-miguel-l-benitez-continuing-the-legacy-of-service-and-leading-victorias-to-the-pinnacle-of-succe/" target="_blank" rel="noopener">Read the account</a>
                </div>
            </article>

            <article class="heritage reveal" data-delay="2">
                <img loading="lazy" decoding="async"
                     src="/img/editorial/34.jpg"
                     alt="Nursing days — the author's years as a registered nurse." />
                <div class="heritage-body">
                    <p class="heritage-date">Tribute</p>
                    <h3>Lola Aling — <em>Rosalina J. Hautea</em></h3>
                    <p>Teacher for 38 years, retired in 1988, and the woman who raised him from the age of seven. “Imo lawas imo kulo, imo kalag imo bakiro” — you manage your own body, you manage your own soul. He was her adopted son, and says so still.</p>
                    <a class="link" href="https://dinoacuna.wordpress.com/2011/10/02/miss-rosalina-j-hautea/" target="_blank" rel="noopener">Read the tribute</a>
                </div>
            </article>

            <article class="heritage reveal" data-delay="3">
                <img loading="lazy" decoding="async"
                     src="/img/editorial/37302_1345123783788_1102069184_30816569_6632685_n-copy.jpg"
                     alt="Mrs. Remedios P. Bantug, known as Idiong Bantug." />
                <div class="heritage-body">
                    <p class="heritage-date">Tribute</p>
                    <h3>Idiong Bantug</h3>
                    <p>Mayor at 82 — a record. A matriarch whose grandfather donated the land where Victorias stands, and who turned compassion into action her whole life. “Thank you Lola Idiong, and farewell.”</p>
                    <a class="link" href="https://dinoacuna.wordpress.com/2011/10/28/in-gratitude-to-mrs-remedios-p-bantug/" target="_blank" rel="noopener">Read the tribute</a>
                </div>
            </article>
        </div>
    </div>
</section>

@* ============================== VIDEOS ============================== *@
<section class="section" id="videos">
    <div class="shell">
        <header class="section-head reveal">
            <p class="section-kicker">05 — Videos</p>
            <h2 class="section-title">Watch the work, <em>unfiltered</em>.</h2>
            <p class="section-lede">
                Council sessions, the Botika Sang Masa rounds, Adopt-a-Victoriasanon
                Family, and the official trips. All clips are published on the official
                Facebook page.
            </p>
        </header>

        <div class="video-toolbar reveal">
            <div class="chips" role="tablist" aria-label="Filter videos">
                <button class="chip is-active" type="button" role="tab" aria-selected="true" data-filter="all">All</button>
                <button class="chip" type="button" role="tab" aria-selected="false" data-filter="council">Council</button>
                <button class="chip" type="button" role="tab" aria-selected="false" data-filter="program">Programmes</button>
                <button class="chip" type="button" role="tab" aria-selected="false" data-filter="field">Field &amp; travel</button>
            </div>
            <a class="link link-strong" href="https://www.facebook.com/dino2022/videos" target="_blank" rel="noopener">
                Open the full video library @Html.Raw(arrow)
            </a>
        </div>

        <div class="videos">
            @foreach (var v in videos)
            {
                var cat = v.Value<string>("category") ?? "council";
                var file = v.Value<string>("thumbFile");
                var dur = v.Value<string>("duration");
                var views = v.Value<string>("views");
                // "when" is a Razor keyword, so bind it under a different name
                var whenText = v.Value<string>("when");
                var still = v.Value<bool>("isStill");
                var url = v.Value<string>("url") ?? "#";
                var title = v.Value<string>("title");
                var caption = v.Value<string>("caption") ?? "";

                // Build the meta line as markup up front — keeps Razor out of
                // the middle of a mixed markup/code block.
                var meta = new System.Text.StringBuilder();
                if (!string.IsNullOrWhiteSpace(views))
                {
                    meta.Append("<b>").Append(views).Append("</b> views");
                }
                if (!string.IsNullOrWhiteSpace(views) && !string.IsNullOrWhiteSpace(whenText))
                {
                    meta.Append("<i>&middot;</i>");
                }
                meta.Append(whenText);
                <article class="vcard reveal" data-category="@cat">
                    <span class="vcard-thumb">
                        @if (!string.IsNullOrWhiteSpace(file))
                        {
                            <img class="vcard-img" src="~/img/thumbs/@file" alt="" loading="lazy" decoding="async" />
                        }
                        <span class="vcard-cat" data-cat="@cat">@CatLabel(cat)</span>
                        @if (still)
                        {
                            <span class="vcard-still">Photo</span>
                        }
                        <span class="vcard-play">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor"/></svg>
                        </span>
                        @if (!string.IsNullOrWhiteSpace(dur) && dur != "—")
                        {
                            <span class="vcard-time">@dur</span>
                        }
                    </span>
                    <div class="vcard-body">
                        <h3>@title</h3>
                        <p>@caption</p>
                        <span class="vcard-meta">@Html.Raw(meta.ToString())</span>
                    </div>
                    <button class="vcard-hit" type="button"
                            data-url="@url" data-title="@title" data-caption="@caption"
                            aria-label="Play video: @title"></button>
                </article>
            }
        </div>
    </div>
</section>

@* ============================== JOURNAL ============================== *@
<section class="section section-alt" id="journal">
    <div class="shell">
        <header class="section-head reveal">
            <p class="section-kicker">06 — Journal</p>
            <h2 class="section-title">From the <em>blog</em>.</h2>
            <p class="section-lede">
                Fifteen years of writing on politics, history, and the people of
                Victorias — mirrored here, and published in full on the original blog.
            </p>
        </header>

        <div class="posts">
            @foreach (var p in posts)
            {
                var url = p.Value<string>("url") ?? "#";
                var pTag = p.Value<string>("tag");
                var pDate = p.Value<string>("date");
                var pTitle = p.Value<string>("title");
                var pExcerpt = p.Value<string>("excerpt");
                var slug = p.Value<string>("wordpressSlug");
                var hasBody = !string.IsNullOrWhiteSpace(p.Value<string>("body"));
                var href = hasBody ? "/post/" + slug : url;
                var external = !hasBody;
                // the 440px card copy, falling back to the full-size image
                var cardThumb = p.Value<string>("cardImage");
                if (string.IsNullOrWhiteSpace(cardThumb)) cardThumb = p.Value<string>("featuredImage");
                <article class="post post-has-img reveal">
                    @if (!string.IsNullOrWhiteSpace(cardThumb))
                    {
                        <a class="post-thumb" href="@href" target="@(external ? "_blank" : "_self")" rel="@(external ? "noopener" : null)" tabindex="-1" aria-hidden="true">
                            <img src="@cardThumb" alt="" loading="lazy" decoding="async" />
                        </a>
                    }
                    <div class="post-body">
                        <div class="post-top">
                            <span class="post-tag">@pTag</span>
                            <time class="post-date">@pDate</time>
                        </div>
                        <h3><a href="@href" target="@(external ? "_blank" : "_self")" rel="@(external ? "noopener" : null)">@pTitle</a></h3>
                        <p>@pExcerpt</p>
                        <a class="link" href="@href" target="@(external ? "_blank" : "_self")" rel="@(external ? "noopener" : null)">
                            @(hasBody ? "Read the post" : "Read on the blog") @Html.Raw(arrow)
                        </a>
                    </div>
                </article>
            }
        </div>

        <p class="journal-count reveal">@posts.Count entries · 2010 to 2025 · originally published at dinoacuna.wordpress.com</p>

        <div class="center reveal">
            <a class="btn btn-ghost" href="https://dinoacuna.wordpress.com/" target="_blank" rel="noopener">
                Visit the original blog
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8M18 13v5.5A1.5 1.5 0 0 1 16.5 20h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H11" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
        </div>
    </div>
</section>

@* ============================== CONNECT ============================== *@
<section class="section connect" id="connect">
    <div class="connect-bg" aria-hidden="true"><span class="orb orb-a"></span><span class="orb orb-b"></span></div>
    <div class="shell">
        <div class="connect-inner">
            <p class="section-kicker reveal">07 — Connect</p>
            <h2 class="section-title reveal" data-delay="1">Keep the conversation going.</h2>
            <p class="connect-lede reveal" data-delay="2">
                Inquiries on the Adopt-a-Forest Program may be directed to VCENRO or to
                the Office of the Councilor. For everything else — messages, invitations,
                the next post — the official page is the fastest route.
            </p>

            <div class="connect-actions reveal" data-delay="3">
                <a class="btn btn-primary" href="https://www.facebook.com/dino2022" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5V7a1.5 1.5 0 0 1 1.5-1.5H17V3h-2.5A4.5 4.5 0 0 0 10 7.5v1H8v2.5h2V21h4v-10h2.6l.4-2.5H14Z" fill="currentColor"/></svg>
                    Official Facebook page
                </a>
                <a class="btn btn-ghost" href="https://www.facebook.com/dino2022/videos" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor"/></svg>
                    Watch all videos
