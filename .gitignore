node_modules/
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.env
.env.local
*.log

# audit output — regenerate with: node tools/audit.mjs <url>
# (the scripts themselves ARE tracked; only the generated artefacts are not)
tools/shots/

# temporary tree built by tools/verify-subpath.mjs
.subpath-check/

# assembled by the Pages workflow
_site/

# dist/ carries the exported markup (committed); the binaries under it are
# copied in from cms/wwwroot by tools/assemble-pages.mjs and are not committed,
# so the repository holds one copy of the images rather than two.
dist/css/
dist/js/
dist/img/
dist/fonts/
